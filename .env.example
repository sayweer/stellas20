# Non-secret, client-side Vite config for Stellar Testnet.
# Copy to .env for local overrides. Only VITE_-prefixed values are exposed to the client.
# NEVER put secrets or private keys here — signing happens inside the connected wallet.
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_FRIENDBOT_URL=https://friendbot.stellar.org
VITE_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# stellas-core v0 contract IDs (Testnet). Redeploy with scripts/deploy-testnet.sh
# and update these. See README for the current deployment.
VITE_MYT_CONTRACT_ID=CDBSSIUJUVXOUNVTJTZ4J2JXO24KPNGYA5V2MF5BBZLIPWRHS3DKDP46
VITE_SY_VAULT_CONTRACT_ID=CBBASA57N7NUSHID6HURLB7ERU3LKX2JEYBGMKABZIMFUPL7Y6WH4H6Z
