# Non-secret, client-side Vite config for Stellar Testnet.
# Copy to .env for local overrides. Only VITE_-prefixed values are exposed to the client.
# NEVER put secrets or private keys here — signing happens inside the connected wallet.
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_FRIENDBOT_URL=https://friendbot.stellar.org
VITE_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# stellas20 v0 contract IDs (Testnet). Redeploy with scripts/deploy-testnet.sh
# and update these. See README for the current deployment.
VITE_MYT_CONTRACT_ID=CDN42W36GJ2AGPWGDMEL2BUEKCGCVCQ4GRLFXUBPTQUDIEDWQQHZG3TR
VITE_SY_VAULT_CONTRACT_ID=CBPCPCDCHGAJUU7BID7DOOKBTIWTRIYYZXGL2YBMJ64KNR53YJD4ANZE
VITE_SPLITTER_CONTRACT_ID=CCBQ4PWTSBKL6RTSL5CFUPVX3SZMLODDJKGH6XFVRZU6UPFXAHHZBSBR
VITE_AMM_CONTRACT_ID=CD4B2YYEMDDRVOFH6EWIXFMP5ZX3YCLMALTYRTGSHCNXDDV3XWNIMILD
# Second market: SY over a real Blend lending position (Phase 6). Leave these
# empty to ship a mock-only build — the market switcher hides itself.
# Deploy with: ./scripts/deploy-testnet.sh --with-blend
VITE_BLEND_SY_VAULT_CONTRACT_ID=CAWXCCBE7RY26LVVWN5QWWOARGDABGQKJMWAYPCM52TT5QZM2UCOGA7J
VITE_BLEND_SPLITTER_CONTRACT_ID=CDRDDE3NQAY5RPQ4KN7MRAOUTJTWITWLSZQWAFP4XRIN23VG7UHE6YOU
VITE_BLEND_AMM_CONTRACT_ID=CBT5RSS37MYLQYEBOYM4GKWSY2MWKQW3RPUPRKQHUVZNKXLZ76TJED75
# The reserve the vault supplies into — testnet XLM (native SAC), friendbot-fundable.
VITE_BLEND_ASSET_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Optional — WalletConnect project id (free: https://dashboard.reown.com).
# Without it the wallet picker only offers wallets that inject into the page,
# which on a phone means none of the extension wallets can connect: Freighter's
# module reports itself unavailable on mobile by design and expects
# WalletConnect instead. Set this to let phones connect.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional — public browser DSN from a Sentry React project. Leave empty to
# disable error reporting locally.
VITE_SENTRY_DSN=

# Optional — shareable Google Form URL for the app's Feedback link. Leave
# empty until the form exists; the link stays hidden when unset.
VITE_FEEDBACK_FORM_URL=
